DATABASE_URL=postgres://orcub:local-development-only@127.0.0.1:55432/orcub
ADMIN_TOKEN=replace-with-at-least-32-random-characters
PORT=8080
RETENTION_DAYS=400
TRUST_COUNTRY_HEADERS=false
RUST_LOG=orcub_backend=info
SQLX_OFFLINE=true
APPLE_ENVIRONMENT=Production
APP_ENV=production
APPLE_ALLOW_XCODE=false
# APPLE_APP_ID=numeric-app-store-id (production notifications)
# Optional online transaction checks: set all three, mount the secret .p8 file.
# APPLE_API_ISSUER_ID=
# APPLE_API_KEY_ID=
# APPLE_API_KEY_PATH=/run/secrets/apple-api.p8
